# ==========================================
# Server
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5000

# ==========================================
# MongoDB
# ==========================================
MONGODB_URI=mongodb://127.0.0.1:27017/ai-chatbot

# ==========================================
# JWT
# ==========================================
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ==========================================
# LLM Provider
# Supported values: gemini | openrouter | groq
# ==========================================
LLM_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/app/apikey) - Free tier
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter (https://openrouter.ai/keys) - Free models available
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Groq (https://console.groq.com/keys) - Free & very fast
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ==========================================
# AI generation defaults
# ==========================================
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1024
SYSTEM_PROMPT=You are a helpful, friendly, and knowledgeable AI assistant. Answer clearly and concisely, and use Markdown formatting (including fenced code blocks with language tags) when it improves readability.
